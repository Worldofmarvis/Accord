datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  BUYER
  SELLER
}

enum NegotiationStatus {
  OPEN
  IN_PROGRESS
  AGREED
  FAILED
  CANCELLED
}

enum OfferBy {
  BUYER_AGENT
  SELLER_AGENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  role      Role
  listings  Listing[]
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Listing {
  id           String        @id @default(uuid())
  sellerId     String
  seller       User          @relation(fields: [sellerId], references: [id])
  title        String
  description  String?
  category     String
  listPrice    Float
  floorPrice   Float         // Private: Never leak to buyer front-end
  negotiations Negotiation[]
  createdAt    DateTime      @default(now())
}

model Negotiation {
  id            String            @id @default(uuid())
  listingId     String
  buyerId       String
  currentRound  Int               @default(1)
  status        NegotiationStatus @default(OPEN)
  buyerMaxPrice Float?
  finalPrice    Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  listing     Listing      @relation(fields: [listingId], references: [id])
  offers      Offer[]
  messages    Message[]
  payments    Payment[]
  auditEvents AuditEvent[]
}

model Offer {
  id            String      @id @default(uuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
  roundNumber   Int
  offeredBy     OfferBy
  proposedPrice Float
  reasoning     String?
  createdAt     DateTime    @default(now())
}

model Message {
  id            String      @id @default(uuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id])
  senderId      String
  sender        User        @relation(fields: [senderId], references: [id])
  content       String
  createdAt     DateTime    @default(now())
}

model Payment {
  id            String        @id @default(uuid())
  negotiationId String
  negotiation   Negotiation   @relation(fields: [negotiationId], references: [id])
  paypalOrderId String        @unique
  amount        Float
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

model AuditEvent {
  id            String   @id @default(uuid())
  negotiationId String?
  eventType     String   // e.g. "OFFER_SUBMITTED", "AUTO_ACCEPTED", "COUNTER_OFFER"
  payload       String   // JSON formatted metadata
  createdAt     DateTime @default(now())

  negotiation   Negotiation? @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
}